# Example locations only. These files are not included in this repository.
# The exact original checksum/ID checks remain enforced by build_standard_manifest.
# Linux/macOS: export these variables. PowerShell: use $env:NAME = 'path'.
VAST_RCABENCH_WINDOWS=/path/to/rcabench/windows.csv
VAST_RCABENCH_CATALOG=/path/to/rcabench/entity_features.csv
VAST_RCABENCH_TRAIN_POOL=/path/to/rcabench/training-pool.json
VAST_RCABENCH_TEST_IDS=/path/to/rcabench/per_case_rankings.jsonl
VAST_AIOPS2022_PRE_WINDOWS=/path/to/aiops22/windows.csv
VAST_AIOPS2022_PRE_CATALOG=/path/to/aiops22/entity_features.csv
VAST_AIOPS2022_PRE_TRAIN_POOL=/path/to/aiops22/training-pool.json
VAST_AIOPS2022_PRE_TEST_IDS=/path/to/aiops22/per_case_rankings.jsonl
